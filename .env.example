DATABASE_URL=postgres://politicando:politicando@localhost:5433/politicando
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3200
# Set to true only when running behind a reverse proxy, so rate limits see the real client IP.
TRUST_PROXY=false
# On Render, set to true-client-ip instead: Render passes on a client-sent X-Forwarded-For, so it
# can be forged. This header (set by Cloudflare in front of Render) is the only one then trusted.
# CLIENT_IP_HEADER=true-client-ip

# Google's public reCAPTCHA v2 test secret: it accepts every token. Local development only.
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Our site's hostnames, comma-separated. In production, set it so tokens solved on other sites are rejected.
RECAPTCHA_HOSTNAMES=

# Keys anonymous forum poster IDs. Generate with `openssl rand -hex 32`; never change it once live.
FORUM_SECRET=local-development-only-forum-secret-0000

# The admin session cookie is HTTPS-only by default. false only for local development over HTTP.
COOKIE_SECURE=false

# Article pages the scanner may open per news source per run. The rest wait for the next run.
INGEST_MAX_PAGES_PER_SOURCE=40

# Legislature the parliament sync reads, as a Roman numeral. Change it when a new one starts.
PARLIAMENT_LEGISLATURE=XVII

# Newsletter. SMTP_URL: empty turns it off, "log" prints emails (with their links) to the console, or smtps://user:pass@host:465.
SMTP_URL=log
MAIL_FROM=Politicando <info@politicando.pt>
# Signs the confirm/unsubscribe links. Generate with `openssl rand -hex 32`; never change it once live.
NEWSLETTER_SECRET=local-development-only-newsletter-secret-00
# Where the links land (the website) and this API's public address (used in the links).
SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
