DATABASE_URL=postgres://politicando:politicando@localhost:5433/politicando
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Set to true only when running behind a reverse proxy, so rate limits see the real client IP.
