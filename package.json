{
  "name": "politicando-backend",
  "private": true,
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "robots-parser": "^3.0.1",
    "stream-json": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/stream-json": "^1.7.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "ingest": "tsx --env-file=.env src/jobs/ingest.ts",
    "parliament:sync": "tsx --env-file=.env src/jobs/syncParliament.ts",
    "parliament:link-news": "tsx --env-file=.env src/jobs/linkNews.ts",
    "government:sync": "tsx --env-file=.env src/jobs/syncGovernment.ts",
    "elections:import": "tsx --env-file=.env src/jobs/importElections.ts",
    "contracts:import": "tsx --env-file=.env src/jobs/importContracts.ts",
    "admin:create": "tsx --env-file=.env src/jobs/createAdmin.ts",
    "places:shapes": "tsx src/jobs/buildMunicipalityShapes.ts"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
